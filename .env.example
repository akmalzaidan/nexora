# Root environment for Docker Compose (NEXORA).
# Copy to .env and adjust before running `docker compose up`.

# --- PostgreSQL ---
# POSTGRES_PASSWORD is REQUIRED. The postgres image refuses to initialise with
# an empty password, and docker-compose fails fast if this variable is unset.
# Replace the placeholder below with your own local secret before starting.
# It must match DB_PASSWORD in backend/.env.
# Values must match backend/.env.example (DB_DATABASE, DB_USERNAME, DB_PASSWORD).
POSTGRES_DB=nexora
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_your_local_password
POSTGRES_PORT=5432

# --- Services ---
# Ports used by the docker-compose services below.
BACKEND_PORT=8000
FRONTEND_PORT=8100