# Root environment for Docker Compose (NEXORA).
# Copy to .env and adjust before running `docker compose up`.

# --- PostgreSQL ---
# Values must match backend/.env.example (DB_DATABASE, DB_USERNAME, DB_PASSWORD).
POSTGRES_DB=nexora
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Services ---
# Ports used by the docker-compose services below.
BACKEND_PORT=8000
FRONTEND_PORT=8100